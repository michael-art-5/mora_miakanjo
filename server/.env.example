# Modèle de configuration — copier en server/.env et compléter (ne jamais versionner server/.env)

# Base PostgreSQL. Vide ou absent : base intégrée PGlite (storage/pgdata), idéale pour développer.
# Neon : copier la chaîne de connexion du tableau de bord (Connection string), elle se termine par ?sslmode=require
DATABASE_URL=

# Premier compte administrateur (utilisé uniquement si la base ne contient aucun utilisateur)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Port de l'API (fourni automatiquement par l'hébergeur en production)
PORT=3001

# Proxy de confiance : « loopback » (IIS sur ce PC, défaut) ou « 1 » (hébergeur type Render)
# TRUST_PROXY=1
