{
  "name": "mora-miakanjo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,site -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --watch-path=server server/index.js",
    "build": "tsc -b && vite build",
    "start": "node server/index.js --production",
    "db:import": "node server/scripts/import-export.js",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "express": "^5.2.1",
    "lucide-react": "^1.48.0",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
